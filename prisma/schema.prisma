generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(cuid())
  clerkId              String               @unique
  email                String               @unique
  name                 String?
  organizationName     String?
  organizationLogo     String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  role                 String?              // CHANGED: no default — null means "hasn't chosen owner/staff yet" (was @default("owner"), which silently made every new signup an owner before onboarding could ask)
  ownerId              String?                          // staff points to owner's user ID
  owner                User?                @relation("StaffRelation", fields: [ownerId], references: [id])
  staff                User[]               @relation("StaffRelation")
  bills                Bill[]
  events               Event[]
  ingredients          Ingredient[]
  ingredientCategories IngredientCategory[]
  items                Item[]
  itemCategories       ItemCategory[]
  categoryPayments     CategoryPayment[]

  @@index([clerkId])
}

model ItemCategory {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     Item[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)

  @@unique([name, userId])
  @@index([userId])
}

model Item {
  id              String           @id @default(cuid())
  name            String
  description     String?
  categoryId      String
  userId          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  eventItems      EventItem[]
  category        ItemCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemIngredients ItemIngredient[]

  @@unique([name, categoryId, userId])
  @@index([categoryId])
  @@index([userId])
}

model IngredientCategory {
  id          String       @id @default(cuid())
  name        String
  userId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sortOrder   Int          @default(0)
  ingredients Ingredient[]
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name, userId])
  @@index([userId])
}

model Ingredient {
  id               String                   @id @default(cuid())
  name             String
  unit             String
  ratePerUnit      Float                    @default(0)
  categoryId       String
  userId           String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  sortOrder        Int                      @default(0)
  eventIngredients EventIngredient[]
  category         IngredientCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceHistory     IngredientPriceHistory[]
  itemIngredients  ItemIngredient[]

  @@unique([name, categoryId, userId])
  @@index([categoryId])
  @@index([userId])
}

model AdvancePayment {
  id        String   @id @default(cuid())
  eventId   String
  amount    Float
  paidDate  DateTime
  notes     String?
  // CHANGED: both nullable and additive — existing advance rows keep billId/groupId
  // null and behave exactly as before.
  //
  // billId: set when the payment was recorded against a BILL rather than taken as an
  // advance before any bill existed. A bill's paid amount is the sum of the rows
  // carrying its id.
  //
  // groupId: one recorded payment can cover several EVENTS on the same bill (see
  // allocateWaterfall), and is stored as one row per event so Event.advancePayment
  // stays a straight per-event sum. groupId ties those rows back together so deleting
  // the payment removes all of it rather than half of it.
  billId    String?
  groupId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bill      Bill?    @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([billId])
  @@index([groupId])
}

model IngredientPriceHistory {
  id           String     @id @default(cuid())
  ingredientId String
  price        Float
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime   @default(now())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
  @@index([startDate, endDate])
}

model ItemIngredient {
  id           String     @id @default(cuid())
  itemId       String
  ingredientId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, ingredientId])
  @@index([itemId])
  @@index([ingredientId])
}

model Event {
  id                    String                 @id @default(cuid())
  eventId               String                 @unique
  organizerName         String
  phoneNumber           String
  location              String
  homeAddress           String?
  bookingDate           DateTime
  functionDate          DateTime
  functionTime          String
  menuCreationDate      DateTime?
  guestCount            Int
  perPlatePrice         Float                  @default(0)
  totalAmount           Float                  @default(0)
  advancePayment        Float                  @default(0)
  status                String                 @default("active")
  notes                 String?
  userId                String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  advancePayments       AdvancePayment[]
  eventCategorySettings EventCategorySetting[]
  eventIngredients      EventIngredient[]
  eventItems            EventItem[]
  categoryPayments      CategoryPayment[]

  @@index([userId])
  @@index([eventId])
  @@index([functionDate])
  // CHANGED: composite index matching the real query shape used by every event
  // list/export route (where userId = ? order by functionDate). Added alongside
  // the existing single-column indexes rather than replacing them — additive only.
  @@index([userId, functionDate])
  @@index([status])
}

model EventItem {
  id           String    @id @default(cuid())
  eventId      String
  itemId       String
  mealLabel    String?
  mealDate     DateTime?
  mealGuests   Int?
  mealPerPlate Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  item         Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([itemId])
  @@index([mealLabel])
}

model EventIngredient {
  id           String     @id @default(cuid())
  eventId      String
  ingredientId String
  quantity     Float      @default(0)
  notes     String?
  priceAtEvent Float?
  status       String     @default("normal")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([eventId, ingredientId])
  @@index([eventId])
  @@index([ingredientId])
}

model EventCategorySetting {
  id                   String @id @default(cuid())
  eventId              String
  ingredientCategoryId String
  boughtBy             String @default("caterer")
  event                Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, ingredientCategoryId])
  @@index([eventId])
}

model Bill {
  id             String     @id @default(cuid())
  billNumber     String     @unique
  customerName   String
  phoneNumber    String
  address        String?
  clientGstNo    String?
  billDate       DateTime   @default(now())
  subtotal       Float      @default(0)
  discountType   String?
  discountValue  Float      @default(0)
  discountAmount Float      @default(0)
  sgst           Float      @default(0)
  cgst           Float      @default(0)
  totalAmount    Float      @default(0)
  // CHANGED: paidAmount and status are NO LONGER READ ANYWHERE. A bill's paid amount is
  // the sum of the AdvancePayment rows on the events it covers, and its status is derived
  // from that against totalAmount — see lib/paymentStatus.ts. These two were what the old
  // "Mark Paid" button set, with no money behind them.
  //
  // Kept as dead columns rather than dropped: this is a live billing database and a
  // destructive migration is not worth it for two floats. Do not start reading them again.
  paidAmount     Float      @default(0)
  status         String     @default("unpaid")
  notes          String?
  userId         String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          BillItem[]
  payments       AdvancePayment[] // CHANGED: payments recorded against this bill

  @@index([userId])
  @@index([billNumber])
  @@index([phoneNumber])
  @@index([status])
  @@index([billDate])
}

model BillItem {
  id          String  @id @default(cuid())
  billId      String
  description String
  quantity    Float   @default(1)
  rate        Float   @default(0)
  amount      Float   @default(0)
  eventId     String?
  bill        Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  // CHANGED: eventId is now READ, not just written. Every "is this event billed, and for
  // how much" lookup filters on it (lib/eventBilling.ts), which the history list, the
  // event page, the bill picker and the revenue page all run. Without this the database
  // scans every bill item in the business on each of those loads.
  @@index([eventId])
}

model CategoryPayment {
  id                   String   @id @default(cuid())
  eventId              String
  ingredientCategoryId String
  categoryName         String
  amount               Float    @default(0)
  paidAt               DateTime @default(now())
  notes                String?
  userId               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  event                Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, ingredientCategoryId])
  @@index([eventId])
  @@index([ingredientCategoryId])
  @@index([userId])
}
